          ] } }]
        },
        {
          "name": "Saldo despues de extraer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Request-Id", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tarjeta\": \"{{tarjetaActiva}}\",\n  \"cuenta\": \"{{cuentaPropia}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/cajero/saldo"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Se debitaron exactamente $500,50', () => {",
            "  const esperado = (Number(pm.collectionVariables.get('saldoAntes')) - 500.50).toFixed(2);",
            "  pm.expect(pm.response.json().saldo.toFixed(2)).to.eql(esperado);",
            "});"
          ] } }]
        },
        {
          "name": "Extraccion - saldo insuficiente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Request-Id", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tarjeta\": \"{{tarjetaActiva}}\",\n  \"cuenta\": \"{{cuentaPropia2}}\",\n  \"importe\": 99999999\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/cajero/extracciones",
            "description": "El saldo nunca puede quedar negativo."
          },
