          ] } }]
        },
        {
          "name": "Extraccion - mas de 2 decimales",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Request-Id", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tarjeta\": \"{{tarjetaActiva}}\",\n  \"cuenta\": \"{{cuentaPropia}}\",\n  \"importe\": 10.123\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/cajero/extracciones"
          },
