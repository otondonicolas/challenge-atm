            "body": { "mode": "raw", "raw": "{\n  \"tarjeta\": \"{{tarjetaActiva}}\",\n  \"cuenta\": \"{{cuentaPropia}}\",\n  \"importe\": 500.50\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/cajero/extracciones",
            "description": "CLI: `atm extraer 4517660000000001 1000000001 500,50` -> \"Retire su dinero\"."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
