            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Request-Id", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tarjeta\": \"{{tarjetaActiva}}\",\n  \"cuenta\": \"{{cuentaPropia}}\",\n  \"importe\": 0\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/cajero/extracciones"
