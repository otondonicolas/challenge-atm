    {
      "name": "5. Validaciones de entrada",
      "item": [
        {
          "name": "Tarjeta con formato invalido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Request-Id", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tarjeta\": \"45176600ABC\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/cajero/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('DATOS_INVALIDOS con detalle por campo', () => {",
            "  const body = pm.response.json();",
            "  pm.expect(body.codigo).to.eql('DATOS_INVALIDOS');",
            "  pm.expect(body.detalles).to.be.an('array').that.is.not.empty;",
            "});"
          ] } }]
        },
        {
          "name": "CBU con formato invalido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Request-Id", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tarjeta\": \"{{tarjetaActiva}}\",\n  \"cbu\": \"123\",\n  \"importe\": 10\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/cajero/depositos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
